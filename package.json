{
  "name": "integrity",
  "version": "1.0.31",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm --parallel -r run build",
    "build:storybook": "pnpm --parallel -r run build:storybook",
    "lint:check": "biome check --staged",
    "lint": "biome check --write --staged --files-ignore-unknown=true --no-errors-on-unmatched",
    "audit:licenses": "pnpm licenses list --long",
    "update:deps": "pnpm up",
    "prepare": "husky || true",
    "create:componentFolder": "node createComponentFolder.ts"
  },
  "packageManager": "pnpm@10.16.1",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "^2.1.2",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/types": "^19.8.1",
    "husky": "^9.1.7"
  }
}
