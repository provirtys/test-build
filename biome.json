{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "overrides": [
    {
      "include": ["*.vue"],
      "linter": {
        "rules": {
          "style": {
            "useConst": "off",
            "useImportType": "off"
          },
          "correctness": {
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 4,
    "ignore": ["**/node_modules/**"],
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "bracketSpacing": true,
      "quoteProperties": "asNeeded",
      "semicolons": "always",
      "lineEnding": "lf",
      "lineWidth": 120
    }
  },
  "json": {
    "formatter": {
      "indentWidth": 2,
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "ignore": ["**/node_modules/**", "**/*.test.*", "./packages/base-ui/src/datamatrix.js"],
    "rules": {
      "correctness": {
        "noUnusedVariables": {},
        "noUnusedFunctionParameters": {},
        "useImportExtensions": {}
      },
      "recommended": true,
      "complexity": {
        "all": true
      },
      "performance": {
        "all": true
      },
      "security": {
        "all": true
      },
      "suspicious": {
        "all": true,
        "noConsole": {
          "options": {
            "allow": ["debug", "log", "error", "info", "warn", "time", "timeEnd"]
          }
        }
      }
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  }
}
