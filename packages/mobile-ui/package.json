{
  "name": "@integrity/mobile-ui",
  "version": "1.0.26",
  "main": "./dist/mobile-ui.umd.js",
  "module": "./dist/mobile-ui.es.js",
  "scripts": {
    "build": "vite build",
    "storybook": "storybook dev -p 3001",
    "build:storybook": "storybook build"
  },
  "exports": {
    ".": {
      "import": "./dist/mobile-ui.es.js",
      "require": "./dist/mobile-ui.umd.js"
    },
    "./style.css": "./dist/mobile-ui.css"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/mobile-ui.es.js"
  },
  "files": [
    "package.json",
    "pnpm-lock.yaml",
    "dist"
  ],
  "peerDependencies": {
    "@integrity/base-ui": "workspace:*",
    "@integrity/icons": "workspace:*"
  },
  "dependencies": {
    "@chromatic-com/storybook": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "sass-embedded": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@pivanov/vite-plugin-svg-sprite": "catalog:",
    "@quasar/extras": "catalog:",
    "@quasar/vite-plugin": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/vue3-vite": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "apexcharts": "catalog:",
    "quasar": "catalog:",
    "storybook": "catalog:",
    "uuid": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vue": "catalog:",
    "vue-i18n": "catalog:",
    "vue-router": "catalog:"
  },
  "type": "module",
  "packageManager": "pnpm@10.11.1"
}
