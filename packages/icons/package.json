{
  "name": "@integrity/icons",
  "description": "Icons asset for usage in other packages",
  "version": "1.0.67",
  "main": "./dist/icons.umd.js",
  "module": "./dist/icons.es.js",
  "files": [
    "icons/"
  ],
  "exports": {
    ".": {
      "import": "./dist/icons.es.js",
      "require": "./dist/icons.umd.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/icons.es.js"
  },
  "type": "module",
  "packageManager": "pnpm@10.11.1"
}
