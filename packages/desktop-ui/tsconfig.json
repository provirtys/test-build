{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@": ["src"],
      "@/*": ["src/*"],
      "@base": ["../base-ui/src"],
      "@base/*": ["../base-ui/src/*"]
    }
  },
  "references": [
    {
      "path": "../base-ui"
    }
  ],
  "include": ["**/src/**/*"],
  "exclude": ["node_modules"]
}
